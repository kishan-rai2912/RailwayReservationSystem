<%@ page import="com.railway.model.User,com.railway.util.Html" %>
<header class="top"><a class="brand" href="${pageContext.request.contextPath}/">🚆 RailConnect</a><nav><a href="${pageContext.request.contextPath}/search">Find trains</a><% User navUser=(User)session.getAttribute("user"); if(navUser!=null){ %><a href="${pageContext.request.contextPath}/my-bookings">My bookings</a><% if("ADMIN".equals(navUser.getRole())){ %><a href="${pageContext.request.contextPath}/admin">Admin</a><% } %><form class="inline" method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="csrf" value="${csrfToken}"><button class="linkbtn">Log out</button></form><% }else{ %><a href="${pageContext.request.contextPath}/login">Log in</a><a class="navcta" href="${pageContext.request.contextPath}/register">Create account</a><% } %></nav></header>
