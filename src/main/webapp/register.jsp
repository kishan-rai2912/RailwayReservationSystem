<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Create account | RailConnect</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="narrow panel"><h1>Create your account</h1><% if(request.getAttribute("error")!=null){ %><p class="alert"><%= com.railway.util.Html.escape(request.getAttribute("error")) %></p><% } %><form method="post" action="${pageContext.request.contextPath}/register" class="stack"><input type="hidden" name="csrf" value="${csrfToken}"><label>Full name<input name="fullName" maxlength="100" required></label><label>Email<input type="email" name="email" maxlength="190" required></label><label>Phone<input name="phone" maxlength="20" required></label><label>Password<input type="password" name="password" minlength="10" maxlength="72" required><small>Use 10–72 characters.</small></label><button class="button">Create account</button></form></main></body></html>
