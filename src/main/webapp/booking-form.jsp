<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Reserve tickets | RailConnect</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"><script src="${pageContext.request.contextPath}/assets/js/validation.js" defer></script></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="narrow panel"><h1>Passenger details</h1><% if(request.getAttribute("error")!=null){ %><p class="alert"><%= com.railway.util.Html.escape(request.getAttribute("error")) %></p><% } %><form method="post" action="${pageContext.request.contextPath}/booking" class="stack" id="bookingForm"><input type="hidden" name="csrf" value="${csrfToken}"><label>Train ID<input type="number" name="trainId" min="1" value="<%= com.railway.util.Html.escape(request.getParameter("trainId")) %>" required></label><label>Journey date<input type="date" name="journeyDate" min="<%= java.time.LocalDate.now() %>" value="<%= com.railway.util.Html.escape(request.getParameter("journeyDate")) %>" required></label><label>Passenger count<select name="passengerCount" id="passengerCount"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></label><div id="passengers"></div><button class="button">Confirm reservation</button><small>Fare is calculated from the database. Demo only; no payment is collected.</small></form></main><script>window.bookingInit && window.bookingInit('${csrfToken}');</script></body></html>
