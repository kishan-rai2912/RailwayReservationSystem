<%@ page contentType="text/html; charset=UTF-8" import="java.util.*,com.railway.util.Html" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Booking details</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="panel"><h1>Booking details</h1><% Map<String,Object> b=(Map<String,Object>)request.getAttribute("booking"); if(b!=null){ %><dl class="details"><dt>PNR</dt><dd><%= Html.escape(b.get("pnr")) %></dd><dt>Status</dt><dd><%= Html.escape(b.get("status")) %></dd><dt>Train</dt><dd><%= Html.escape(b.get("train_number")) %> — <%= Html.escape(b.get("train_name")) %></dd><dt>Route</dt><dd><%= Html.escape(b.get("source")) %> → <%= Html.escape(b.get("destination")) %></dd><dt>Journey date</dt><dd><%= Html.escape(b.get("journey_date")) %></dd><dt>Departure / arrival</dt><dd><%= Html.escape(b.get("departure_time")) %> / <%= Html.escape(b.get("arrival_time")) %></dd><dt>Passengers</dt><dd><%= Html.escape(b.get("passenger_count")) %></dd><dt>Total fare</dt><dd>₹<%= Html.escape(b.get("total_fare")) %></dd></dl><% if("CONFIRMED".equals(b.get("status"))){ %><form method="post" action="${pageContext.request.contextPath}/cancel-booking" onsubmit="return confirm('Cancel this demo booking?');"><input type="hidden" name="csrf" value="${csrfToken}"><input type="hidden" name="pnr" value="<%= Html.escape(b.get("pnr")) %>"><button class="button danger">Cancel booking</button></form><% } %><% } %></main></body></html>
