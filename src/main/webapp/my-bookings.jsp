<%@ page contentType="text/html; charset=UTF-8" import="java.util.*,com.railway.util.Html" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>My bookings</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main><h1>My bookings</h1><% if("1".equals(request.getParameter("cancelled"))){ %><p class="success">Booking cancelled. Seats have been released.</p><% }else if("0".equals(request.getParameter("cancelled"))){ %><p class="alert">Booking was already cancelled or could not be cancelled.</p><% } %><% List<Map<String,Object>> bs=(List<Map<String,Object>>)request.getAttribute("bookings");if(bs==null||bs.isEmpty()){ %><section class="panel">You have no bookings yet.</section><% }else{for(Map<String,Object>b:bs){ %><section class="train-card"><div><h2><%= Html.escape(b.get("train_name")) %></h2><p><%= Html.escape(b.get("source")) %> → <%= Html.escape(b.get("destination")) %></p></div><div><small>PNR</small><strong><%= Html.escape(b.get("pnr")) %></strong></div><div><small>Journey</small><strong><%= Html.escape(b.get("journey_date")) %></strong></div><div><small>Status</small><strong><%= Html.escape(b.get("status")) %></strong></div><a href="${pageContext.request.contextPath}/booking-details?pnr=<%= java.net.URLEncoder.encode((String)b.get("pnr"),java.nio.charset.StandardCharsets.UTF_8) %>">Details</a></section><% }} %></main></body></html>
