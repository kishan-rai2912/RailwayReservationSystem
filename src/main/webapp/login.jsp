<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Log in | RailConnect</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="narrow panel"><h1>Welcome back</h1><p>Sign in to manage your journeys.</p><% if(request.getAttribute("error")!=null){ %><p class="alert"><%= com.railway.util.Html.escape(request.getAttribute("error")) %></p><% } %><% if(request.getAttribute("notice")!=null){ %><p class="success"><%= com.railway.util.Html.escape(request.getAttribute("notice")) %></p><% } %><form method="post" action="${pageContext.request.contextPath}/login" class="stack"><input type="hidden" name="csrf" value="${csrfToken}"><label>Email<input type="email" name="email" required autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="button">Log in</button></form><p>New here? <a href="${pageContext.request.contextPath}/register">Create an account</a></p></main></body></html>
