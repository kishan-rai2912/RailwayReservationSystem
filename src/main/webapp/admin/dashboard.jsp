<%@ page contentType="text/html; charset=UTF-8" import="java.util.*,com.railway.util.Html" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Admin dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main><h1>Admin dashboard</h1><p>Administrative data is restricted to database-backed ADMIN accounts.</p><a class="button" href="${pageContext.request.contextPath}/admin-add-train">Add train</a><h2>Trains</h2><div class="tablewrap"><table><tr><th>No.</th><th>Name</th><th>Route</th><th>Active</th><th>Capacity</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("trains")){ %><tr><td><%= Html.escape(x.get("train_number")) %></td><td><%= Html.escape(x.get("train_name")) %></td><td><%= Html.escape(x.get("source")) %> → <%= Html.escape(x.get("destination")) %></td><td><%= Html.escape(x.get("active")) %></td><td><%= Html.escape(x.get("capacity")) %></td></tr><% } %></table></div><h2>Recent bookings</h2><div class="tablewrap"><table><tr><th>PNR</th><th>Status</th><th>Fare</th><th>Passengers</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("bookings")){ %><tr><td><%= Html.escape(x.get("pnr")) %></td><td><%= Html.escape(x.get("status")) %></td><td><%= Html.escape(x.get("total_fare")) %></td><td><%= Html.escape(x.get("passenger_count")) %></td></tr><% } %></table></div><h2>Recent users</h2><div class="tablewrap"><table><tr><th>Name</th><th>Email</th><th>Role</th></tr><% for(Map<String,Object>x:(List<Map<String,Object>>)request.getAttribute("users")){ %><tr><td><%= Html.escape(x.get("full_name")) %></td><td><%= Html.escape(x.get("email")) %></td><td><%= Html.escape(x.get("role")) %></td></tr><% } %></table></div></main></body></html>
