<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Add train</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="narrow panel"><h1>Add train</h1><% if(request.getAttribute("error")!=null){ %><p class="alert"><%= com.railway.util.Html.escape(request.getAttribute("error")) %></p><% } %><form method="post" action="${pageContext.request.contextPath}/admin-add-train" class="stack"><input type="hidden" name="csrf" value="${csrfToken}"><label>Train number<input name="number" required></label><label>Train name<input name="name" required></label><label>Source<input name="source" required></label><label>Destination<input name="destination" required></label><label>Departure time<input type="time" name="departure" required></label><label>Arrival time<input type="time" name="arrival" required></label><label>Fare (INR)<input type="number" min="0" step="0.01" name="fare" required></label><label>Seat capacity<input type="number" min="1" max="10000" name="capacity" required></label><button class="button">Save train</button></form><p>After adding a train, run the schedule generation SQL to create journey-date availability.</p></main></body></html>
