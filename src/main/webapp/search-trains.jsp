<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Find trains | RailConnect</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main class="narrow panel"><h1>Find your train</h1><% if(request.getAttribute("error")!=null){ %><p class="alert"><%= com.railway.util.Html.escape(request.getAttribute("error")) %></p><% } %><form method="post" action="${pageContext.request.contextPath}/search" class="stack"><input type="hidden" name="csrf" value="${csrfToken}"><label>From<input name="source" required></label><label>To<input name="destination" required></label><label>Journey date<input type="date" name="journeyDate" min="<%= java.time.LocalDate.now() %>" required></label><button class="button">Search trains</button></form></main></body></html>
