<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>RailConnect | Railway Reservation</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="/WEB-INF/jsp/header.jspf" %><main><section class="hero"><div><p class="eyebrow">YOUR JOURNEY STARTS HERE</p><h1>Every journey,<br><span>one simple booking.</span></h1><p>Search routes, check availability and reserve your next trip.</p><a class="button" href="${pageContext.request.contextPath}/search">Find a train →</a></div><div class="hero-art" aria-hidden="true">🚆<div>TRAVEL MADE SIMPLE</div></div></section><section class="panel"><h2>Search trains</h2><form action="${pageContext.request.contextPath}/search" method="post" class="searchgrid"><input type="hidden" name="csrf" value="${csrfToken}"><label>From<input name="source" required placeholder="New Delhi"></label><label>To<input name="destination" required placeholder="Agra Cantt"></label><label>Journey date<input type="date" name="journeyDate" min="<%= java.time.LocalDate.now() %>" required></label><button class="button">Search trains</button></form></section><p class="disclaimer">Demo project only. No real railway inventory, payment processing or official ticket is provided.</p></main><script src="${pageContext.request.contextPath}/assets/js/validation.js"></script></body></html>
